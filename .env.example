# App
NEXT_PUBLIC_APP_URL=https://paid-app.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server only: cron, admin updates)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-only; used by /api/invoices/draft-reminder and cron)
ANTHROPIC_API_KEY=
# Optional — default is claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Intuit QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Required for Development/sandbox app + sandbox company (otherwise API returns 403 / 3100)
QUICKBOOKS_USE_SANDBOX=true

# Google OAuth (Gmail send) — same client as GCP project for Workspace add-on
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — SaaS subscriptions (Checkout + Customer Portal) + Connect / invoice checkout
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs from Stripe Dashboard (Products → Prices), not product IDs (price_…)
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Protect cron + manual triggers (Vercel sets x-vercel-cron for scheduled runs)
CRON_SECRET=
